+/*
+ * ---- v2 clients: Turnip's Darwin backend (SweetAccelerator.cpp, NativeAdreno ABI v1) ----
+ * After ios-flame's sweet_gpu.c (0105-0122), with the A615's limits: 32-bit GPU addresses, so the
+ * per-connection windows sit below 4 GB, and GPU buffers come from low RAM XNU never manages.
+ */
+
+/* Hang detection by progress, recovery, and the fences each reset lost: (lo, hi] (the last LOST_RING) */
+static uint32_t progress_fence;
+static uint64_t progress_abs;
+#define LOST_RING       8
+static uint64_t recoveries;
+static struct { uint32_t lo, hi; } lost[LOST_RING];
+
+static void
+gpu_note_submit_locked(void)
+{
+	uint32_t done = a6_fence_read(&gpu);
+	if (done == gpu.fence) {
+		progress_fence = done;
+		progress_abs = mach_absolute_time();
+	}
+}
+
+static bool
+gpu_hung_locked(uint32_t hang_ms)
+{
+	uint32_t done = a6_fence_read(&gpu);
+	uint64_t now = mach_absolute_time(), ns;
+	if (done != progress_fence || (int32_t)(gpu.fence - done) <= 0) {
+		progress_fence = done;
+		progress_abs = now;
+		return false;
+	}
+	absolutetime_to_nanoseconds(now - progress_abs, &ns);
+	return ns > hang_ms * 1000000ULL;
+}
+
+/* Soft reset + CP re-init; everything queued is lost, its fences complete at once (waiters return). */
+static void
+gpu_recover_locked(const char *why)
+{
+	uint64_t far;
+	uint32_t syn, fsr = a6_fault_status(&gpu, &far, &syn), done = a6_fence_read(&gpu);
+	a6_log("%s: GPU hang or fault (fence %u, done %u, smmu fsr %x far %llx fsynr0 %x): reset\n",
+	    why, gpu.fence, done, fsr, far, syn);
+	a6_log("%s: rb rptr %x wptr %x, ib1 %08x%08x rem %x, ib2 %08x%08x rem %x, rbbm status %x\n", why,
+	    a6_rd(0x05000000ULL + 4 * 0x806), gpu.wptr, a6_rd(0x05000000ULL + 4 * 0x929), a6_rd(0x05000000ULL + 4 * 0x928),
+	    a6_rd(0x05000000ULL + 4 * 0x92a), a6_rd(0x05000000ULL + 4 * 0x92c), a6_rd(0x05000000ULL + 4 * 0x92b),
+	    a6_rd(0x05000000ULL + 4 * 0x92d), a6_rd(0x05000000ULL + 4 * 0x210));
+	lost[recoveries % LOST_RING].lo = done;
+	lost[recoveries % LOST_RING].hi = gpu.fence;
+	recoveries++;
+	if (a6_recover(&gpu)) {
+		a6_log("%s: GPU not recovered\n", why);
+		gpu_ready = false;
+	}
+	blit_state_done = false;	/* the soft reset dropped the 2D state */
+	a6_fence_force(&gpu);
+	progress_fence = gpu.fence;
+	progress_abs = mach_absolute_time();
+}
