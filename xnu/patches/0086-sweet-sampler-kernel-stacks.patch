+/*
+ * Kernel side of a sampled thread (0086): scheduler state, block hint
+ * (osfmk/kern/block_hint.h), wait event, and for a thread that is blocked
+ * with a kernel stack, its saved kernel lr plus a frame-pointer backtrace
+ * walked only inside its own kernel stack. Addresses are unslid
+ * (VM_KERNEL_UNSLIDE): look them up in kernel.development.sweet as is.
+ * Threads parked on a continuation have no stack: "cont" shows it instead.
+ */
+static void
+sweet_sample_kernel(const char *name, int tn, thread_t thread)
+{
+	char line[400];
+	int n = snprintf(line, sizeof(line), "SMP %s t%d K state 0x%x hint %u ev 0x%llx", name, tn,
+	    thread->state, (unsigned)thread->block_hint, (unsigned long long)thread->wait_event);
+	vm_offset_t ks = thread->kernel_stack;
+
+	if (thread == current_thread() || (thread->state & TH_RUN) || !(thread->state & TH_WAIT)) {
+		n += snprintf(line + n, sizeof(line) - n, " (not blocked)");
+	} else if (ks == 0) {
+		n += snprintf(line + n, sizeof(line) - n, " cont 0x%lx",
+		    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)thread->continuation));
+	} else {
+		struct arm_kernel_saved_state *kss = &thread_get_kernel_state(thread)->machine.ss;
+		uint64_t fp = kss->fp;
+		n += snprintf(line + n, sizeof(line) - n, " klr 0x%lx kbt",
+		    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)kss->lr));
+		for (int i = 0; i < 16 && n < (int)sizeof(line) - 24; i++) {
+			if ((fp & 7) || fp < ks || fp + 16 > ks + kernel_stack_size) {
+				break;
+			}
+			uint64_t *frame = (uint64_t *)fp;
+			n += snprintf(line + n, sizeof(line) - n, " 0x%lx",
+			    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)frame[1]));
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+	}
+	printf("%s\n", line);
+}
