+/*
+ * Persistent console log on the eMMC, the same layout patch 0047 writes to
+ * sweet's UFS (tools/sweet-log-pull.sh reads it unchanged from a recovery):
+ * the last 1 + 1024 4-KiB blocks of the partition, block 0 a header
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes | u64 flush seq
+ * then the ring (console byte n at ring offset n % size). Every
+ * ufslogsecs seconds (default 10, 1-60) new ring blocks, then the header,
+ * are written, then the card's cache is flushed (EXT_CSD FLUSH_CACHE; if the
+ * card refuses it, e.g. cache off, flushing stops). Needs emmcrw=1; the HFS
+ * root ends far before (16 GiB image in a ~50 GiB partition).
+ * Boot-arg sweetlog=0 disables it.
+ */
+#define LOG_BLOCK       4096u
+#define LOG_SPB         (LOG_BLOCK / SECTOR)    /* sectors per 4 KiB block */
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static int sweet_emmc_log_chan;
+static uint32_t sweet_emmc_log_secs = 10;
+
+static void
+sweet_emmc_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t size = 0;
+	const char *ring = sweet_log_ring_buffer(&size);
+	uint32_t nblk = 1 + size / LOG_BLOCK;
+	/* Whole 4 KiB blocks from the partition start, as the pull script counts. */
+	uint64_t base = se.first + (se.nsect / LOG_SPB - nblk) * LOG_SPB;
+	uint64_t flushed = 0, seq = 0;
+	bool cache_flush = true;
+	void *bounce = (void *)(se.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the eMMC partition (sector 0x%llx)\n",
+	    nblk * LOG_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_emmc_log_chan, PZERO, "sweetlog", hz * (int)sweet_emmc_log_secs);
+		uint64_t total = sweet_log_position();
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= size ? total - size : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_emmc_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % size);
+			uint32_t blk = off / LOG_BLOCK;
+			uint64_t need = ((uint64_t)off % LOG_BLOCK + (total - pos) + LOG_BLOCK - 1) / LOG_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(size / LOG_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / LOG_BLOCK));
+			memcpy(bounce, ring + (uint64_t)blk * LOG_BLOCK, n * LOG_BLOCK);
+			error = emmc_write(base + (uint64_t)(1 + blk) * LOG_SPB, n * LOG_SPB);
+			pos += (uint64_t)(blk + n) * LOG_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = size, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, LOG_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = emmc_write(base, LOG_SPB);
+		}
+		if (!error && cache_flush && ext_csd_switch(32, 1)) {
+			cache_flush = false;
+			printf("SWEET LOG: eMMC cache flush refused; writing without it\n");
+		}
+		lck_mtx_unlock(&sweet_emmc_lock);
+		if (error) {
+			printf("SWEET LOG: eMMC write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_emmc_log_start(void)
+{
+	uint32_t on = 1, size = 0;
+	thread_t thread;
+
+	(void)sweet_log_ring_buffer(&size);
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !se.writable || se.nsect / LOG_SPB < 2 * (1 + size / LOG_BLOCK)) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_emmc_log_secs, sizeof(sweet_emmc_log_secs));
+	if (sweet_emmc_log_secs == 0 || sweet_emmc_log_secs > 60) {
+		sweet_emmc_log_secs = 10;
+	}
+	if (kernel_thread_start(sweet_emmc_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
