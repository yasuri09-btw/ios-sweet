-/* Switch on ts_1p8 (PM660 GPIO13 as a high digital output). */
+/*
+ * Kernel 0087 drove PM660 GPIO13 (peripheral 0xcc) as a high output instead
+ * of GPIO12. It read mode 0x00, out 0x00, en 0x80 before that: put exactly
+ * those values back if it still looks like 0087 left it (mode 0x01, out 0x80).
+ */
+static void
+bonito_restore_gpio13(void)
+{
+	bool apps = false;
+	uint16_t apid = bonito_apid(BONITO_GPIO13_PPID, &apps);
+	uint8_t type = 0, mode = 0, out = 0, en = 0;
+	if (apid == 0xffffu || !apps || !bonito_pmic_read(apid, 0x04, &type) || type != 0x10u ||
+	    !bonito_pmic_read(apid, 0x40, &mode) || !bonito_pmic_read(apid, 0x44, &out) ||
+	    !bonito_pmic_read(apid, 0x46, &en)) {
+		return;
+	}
+	if (mode != 0x01u || out != 0x80u) {
+		printf("SWEET TOUCH: PM660 GPIO13 mode=%#x out=%#x en=%#x (left as is)\n", mode, out, en);
+		return;
+	}
+	vm_offset_t ch = ml_io_map(BONITO_SPMI_CHNLS + 0x10000u * apid, 0x1000);
+	bool ok = ch && bonito_pmic_write(ch, 0x44, 0x00) && bonito_pmic_write(ch, 0x40, 0x00) &&
+	    bonito_pmic_write(ch, 0x46, 0x80);
+	(void)bonito_pmic_read(apid, 0x40, &mode);
+	(void)bonito_pmic_read(apid, 0x44, &out);
+	(void)bonito_pmic_read(apid, 0x46, &en);
+	printf("SWEET TOUCH: PM660 GPIO13 restored=%d: mode=%#x out=%#x en=%#x\n", ok, mode, out, en);
+}
