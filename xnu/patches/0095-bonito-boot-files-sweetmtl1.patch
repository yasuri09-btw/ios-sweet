diff --git a/bsd/dev/sweet_bootfiles.c b/bsd/dev/sweet_bootfiles.c
new file mode 100644
index 0000000..8aea797
--- /dev/null
+++ b/bsd/dev/sweet_bootfiles.c
@@ -0,0 +1,184 @@
+/*
+ * Boot files: install files carried by the boot image into the root
+ * filesystem before launchd starts (no USB networking needed).
+ *
+ * tools/mkpayload.py --files LIST appends one blob after the kernel (like
+ * --ramdisk: it lies inside topOfKernelData, never handed to the VM) and sets
+ * /chosen/memory-map "SweetFiles" = <phys, size>. Blob, little endian:
+ *
+ *   char magic[8] = "SWBFILE1"; u32 count; u32 0
+ *   count x { u32 mode; u16 pathlen (with NUL); u16 type (0 file, 1 dir,
+ *             2 symlink: data = target); u64 size; path, pad to 8;
+ *             data, pad to 8 }
+ *
+ * Parent directories are created (0755). Files are written root:wheel with
+ * the given mode, replacing what is there. Runs from bsdinit_task, right
+ * before load_init_program, so launchd sees e.g. a new launchd.plist on the
+ * same boot. Each file is logged as "SWEET FILES: ...".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <sys/uio.h>
+#include <libkern/libkern.h>
+#include <pexpert/device_tree.h>
+#include <sys/sysproto.h>
+#include <machine/machine_routines.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+void sweet_bootfiles_install(void);
+
+#define SBF_CHUNK	(1024 * 1024)
+
+struct sbf_hdr {
+	char     magic[8];
+	uint32_t count, zero;
+};
+
+struct sbf_ent {
+	uint32_t mode;
+	uint16_t pathlen, type;
+	uint64_t size;
+};
+
+static int
+sbf_mkparents(const char *path)
+{
+	char buf[MAXPATHLEN];
+	strlcpy(buf, path, sizeof(buf));
+	for (char *p = buf + 1; *p; p++) {
+		if (*p != '/') {
+			continue;
+		}
+		*p = '\0';
+		int err = sweet_vfs_mkdir(buf, 0755);
+		*p = '/';
+		if (err && err != EEXIST) {
+			return err;
+		}
+	}
+	return 0;
+}
+
+static int
+sbf_setattr(const char *path, uint32_t mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sbf_write(const char *path, uint32_t mode, const uint8_t *data, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	(void)sweet_vfs_unlink(path);   /* a fresh inode: a running copy keeps the old one */
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	for (uint64_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((uint64_t)SBF_CHUNK, size - off);
+		int resid = 0;
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)(data + off), chunk, (off_t)off,
+		    UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err && resid) {
+			err = EIO;
+		}
+		off += (uint64_t)chunk;
+	}
+	int cerr = vnode_close(vp, FWRITE, ctx);
+	err = err ? err : cerr;
+	return err ? err : sbf_setattr(path, mode);
+}
+
+void
+sweet_bootfiles_install(void)
+{
+	DTEntry mmap;
+	void const *prop;
+	unsigned psize;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess ||
+	    SecureDTGetProperty(mmap, "SweetFiles", &prop, &psize) != kSuccess || psize < 16) {
+		return;
+	}
+	const uint64_t *r = prop;
+	uint64_t pa = r[0], len = r[1];
+	const uint8_t *base = (const uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
+	const struct sbf_hdr *h = (const struct sbf_hdr *)base;
+	if (len < sizeof(*h) || memcmp(h->magic, "SWBFILE1", 8) != 0) {
+		printf("SWEET FILES: bad blob at 0x%llx (%llu bytes)\n", pa, len);
+		return;
+	}
+	uint64_t off = sizeof(*h);
+	unsigned ok = 0;
+	for (uint32_t i = 0; i < h->count; i++) {
+		if (off + sizeof(struct sbf_ent) > len) {
+			printf("SWEET FILES: truncated at entry %u\n", i);
+			break;
+		}
+		const struct sbf_ent *e = (const struct sbf_ent *)(base + off);
+		off += sizeof(*e);
+		const char *path = (const char *)(base + off);
+		off += (e->pathlen + 7) & ~7ULL;
+		const uint8_t *data = base + off;
+		off += (e->size + 7) & ~7ULL;
+		if (off > len || e->pathlen < 2 || path[e->pathlen - 1] != '\0' || path[0] != '/') {
+			printf("SWEET FILES: bad entry %u\n", i);
+			break;
+		}
+		int err = sbf_mkparents(path);
+		if (!err) {
+			switch (e->type) {
+			case 0:
+				err = sbf_write(path, e->mode, data, e->size);
+				break;
+			case 1:
+				err = sweet_vfs_mkdir(path, (int)(e->mode & 07777));
+				err = err == EEXIST ? 0 : err;
+				if (!err) {
+					err = sbf_setattr(path, e->mode);
+				}
+				break;
+			case 2: {
+				char target[MAXPATHLEN];
+				size_t n = MIN((size_t)e->size, sizeof(target) - 1);
+				memcpy(target, data, n);
+				target[n] = '\0';
+				(void)sweet_vfs_unlink(path);
+				err = sweet_vfs_symlink(target, path);
+				break;
+			}
+			default:
+				err = EINVAL;
+			}
+		}
+		printf("SWEET FILES: %s %llu bytes mode %o: %s (%d)\n", path, e->size, e->mode,
+		    err ? "FAILED" : "ok", err);
+		ok += !err;
+	}
+	printf("SWEET FILES: %u of %u installed\n", ok, h->count);
+	/* Let the journal and data reach the disk even if the boot dies early. */
+	int32_t rv;
+	sync(kernproc, NULL, &rv);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
