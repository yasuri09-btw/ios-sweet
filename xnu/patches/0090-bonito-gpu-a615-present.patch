+/*
+ * Adreno 615 core (see sweet_a6xx.h). The power-up is the sequence that
+ * first worked in the bonito shim (shim/gpu.c), which has the reasoning; the
+ * values come from mainline Linux drm/msm (a6xx_gmu.c, a6xx_hfi.c,
+ * a6xx_gpu.c, a6xx_catalog.c), bonito's device tree and Mesa's
+ * freedreno_devices.py. The ring/mapping/blit layer follows ios-flame's
+ * sweet_a6xx.c (MIT, dipa-studio).
+ */
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+#ifdef KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+#include "sweet_a6xx.h"
+
+#define rd32		a6_rd
+#define wr32		a6_wr
+
+#define GCC		0x00100000ull
+#define GPUCC		0x05090000ull
+#define GPU		0x05000000ull
+#define GREG(o)		(GPU + 4ull * (o))
+#define GMU_REG(o)	(GPU + 4ull * (o))	/* GMU offsets are based on the GPU start */
+#define SMMU		0x05040000ull
+#define RSCC		(0x0506a000ull + 0x23000)
+#define RSCC_REG(o)	(RSCC + 4ull * (o))
+#define PDC		0x0b280000ull
+#define PDC_REG(o)	(PDC + 4ull * (o))
+#define PDC_SEQ		0x0b480000ull
+#define CMD_DB		0x85fe0000ull	/* reserved-memory aop-cmd-db-mem */
+
+#define GPUCC_CX_GDSCR	0x106c
+#define GPUCC_GX_GDSCR	0x100c
+#define GPUCC_GMU_RCG	0x1120
+#define GPUCC_CXO	0x109c
+#define GPUCC_CX_GMU	0x1098
+
+#define GMU_GX_SPTPRAC_PWR	0x1a881
+#define GMU_ITCM		0x1b400
+#define GMU_DTCM		0x1c400
+#define GMU_BOOT_SLUMBER	0x1cbf8
+#define GMU_GX_VOTE_IDX		0x1cbf9
+#define GMU_MX_VOTE_IDX		0x1cbfa
+#define GMU_FW_VERSION		0x1d3f8
+#define GMU_SYSRESET		0x1f800
+#define GMU_BOOT_CFG		0x1f801
+#define GMU_INIT_RESULT		0x1f81c
+#define GMU_CM3_CFG		0x1f82d
+#define GMU_PWRCOL_CTRL		0x1f8c0
+#define GMU_SPTPRAC_STATUS	0x1f8d0
+#define GMU_RPMH_CTRL		0x1f8e8
+#define GMU_RPMH_STATE		0x1f8ec
+#define GMU_CP_MSG		0x1f900
+#define GMU_CP_RESP		0x1f901
+#define GMU_HFI_CTRL_STATUS	0x1f980
+#define GMU_SFR_ADDR		0x1f982
+#define GMU_QTBL_INFO		0x1f984
+#define GMU_QTBL_ADDR		0x1f985
+#define GMU_HFI_CTRL_INIT	0x1f986
+#define GMU_G2H_CLR		0x1f991
+#define GMU_G2H_INFO		0x1f992
+#define GMU_H2G_SET		0x1f994
+#define GMU_ICACHE_CFG		0x1f400
+#define GMU_DCACHE_CFG		0x1f401
+#define GMU_SYS_BUS		0x1f40f
+#define GMU_GENERAL_7		0x1f9cc
+#define GMU_FENCE0		0x23b11
+
+#define RBBM_STATUS		0x210
+#define RBBM_INT_STATUS		0x201
+#define CP_RB_BASE		0x800
+#define CP_RB_CNTL		0x802
+#define CP_RB_RPTR		0x806
+#define CP_RB_WPTR		0x807
+#define CP_SQE_CNTL		0x808
+#define CP_HW_FAULT		0x821
+#define CP_STATUS_1		0x825
+#define CP_SQE_INSTR_BASE	0x830
+
+/* SMMU (arm,smmu-v2 at 0x5040000) */
+#define SMMU_GR1	(SMMU + 0x1000)
+#define SMMU_CB(n)	(SMMU + 0x8000 + 0x1000ull * (n))
+#define SMR(n)		(SMMU + 0x800 + 4ull * (n))
+#define S2CR(n)		(SMMU + 0xc00 + 4ull * (n))
+#define CBAR(n)		(SMMU_GR1 + 4ull * (n))
+#define CBA2R(n)	(SMMU_GR1 + 0x800 + 4ull * (n))
+#define CB_SCTLR	0x00
+#define CB_TCR2		0x10
+#define CB_TTBR0	0x20
+#define CB_TCR		0x30
+#define CB_MAIR0	0x38
+#define CB_FSR		0x58
+#define CB_FAR		0x60
+#define CB_FSYNR0	0x68
+#define CB_TLBIALL	0x618
+#define CB_TLBSYNC	0x7f0
+#define CB_TLBSTATUS	0x7f4
+#define TCR2_VAL	2		/* 40-bit PA */
+#define FSR_FAULT	0xc00001feu
+
+#define GMU_SID		5
+#define GPU_SID		0
+
+/* pool layout (GMU part) */
+#define OFF_GMU_L1	0x0000
+#define OFF_GMU_L2	0x1000
+#define OFF_GMU_L3	0x2000
+#define OFF_DUMMY	0x10000
+#define OFF_DEBUG	0x11000
+#define OFF_LOG		0x15000
+#define OFF_HFI		0x19000
+#define VA_DUMMY	0x60000000u
+#define VA_DEBUG	0x60001000u
+#define VA_LOG		0x60005000u
+#define VA_HFI		0x60009000u
+
+#define PAS_GPU		13
+#define ZAP_REGION	0x97a15000ull	/* reserved-memory gpu@97a15000 */
+#define ZAP_SIZE	0x2000ull
+#define SCM_PIL(cmd)	(0x42000000ull | (2u << 8) | (cmd))
+
+/* ---- helpers ---- */
+
+static void wr64(uint64_t pa, uint64_t v)
+{
+	uint32_t w[2] = { (uint32_t)v, (uint32_t)(v >> 32) };
+	a6_write(pa, w, 8);
+}
+
+static void delay_ms(unsigned ms)
+{
+	a6_delay_us(1000 * ms);
+}
+
+static int wait_bit(uint64_t pa, uint32_t mask, int set, unsigned ms)
+{
+	for (unsigned i = 0; i <= 10 * ms; i++) {
+		if (!!(rd32(pa) & mask) == set)
+			return 0;
+		if (i < 10 * ms)
+			a6_delay_us(100);
+	}
+	return -1;
+}
+
+static void zero_pa(uint64_t pa, uint64_t size)
+{
+	static const uint8_t z[0x4000];
+	for (uint64_t o = 0; o < size; o += sizeof(z))
+		a6_write(pa + o, z, (size_t)(size - o < sizeof(z) ? size - o : sizeof(z)));
+}
+
+static int branch_on(const char *name, uint64_t reg)
+{
+	wr32(reg, rd32(reg) | 1);
+	int rc = wait_bit(reg, 1u << 31, 0, 10);
+	if (rc)
+		a6_log("%s %x still halted\n", name, rd32(reg));
+	return rc;
+}
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa)
+{
+	memset(g, 0, sizeof(*g));
+	g->pool_pa = pool_pa;
+	g->gmu_smr = g->gmu_cb = g->gpu_smr = g->gpu_cb = -1;
+}
+
+/* ---- stage 1: CX power ---- */
+
+static int power_cx(struct a6_gpu *g)
+{
+	branch_on("gcc gpu_cfg_ahb", GCC + 0x71004);
+	branch_on("gcc ddrss_gpu_axi", GCC + 0x44038);
+	/* memnoc (BRANCH_VOTED) and snoc_dvm report halted until used: just enable them */
+	wr32(GCC + 0x7100c, rd32(GCC + 0x7100c) | 1);
+	wr32(GCC + 0x71018, rd32(GCC + 0x71018) | 1);
+
+	uint64_t gdsc = GPUCC + GPUCC_CX_GDSCR;
+	wr32(gdsc, rd32(gdsc) & ~1u);
+	if (wait_bit(gdsc, 1u << 31, 1, 100)) {
+		a6_log("cx gdsc %x: timeout\n", rd32(gdsc));
+		return -1;
+	}
+	uint64_t rcg = GPUCC + GPUCC_GMU_RCG;	/* gmu_clk_src: XO, divider 1 */
+	wr32(rcg + 4, (rd32(rcg + 4) & ~0x71fu) | 1u);
+	wr32(rcg, rd32(rcg) | 1u);
+	(void)wait_bit(rcg, 1, 0, 10);
+	branch_on("gpucc cxo", GPUCC + GPUCC_CXO);
+	if (branch_on("gpucc cx_gmu", GPUCC + GPUCC_CX_GMU))
+		return -1;
+
+	uint32_t idr0 = rd32(SMMU + 0x20), idr1 = rd32(SMMU + 0x24);
+	g->n_smr = (int32_t)(idr0 & 0xff);
+	g->n_cb = (int32_t)(idr1 & 0xff);
+	if (g->n_smr > 32)
+		g->n_smr = 32;
+	if (g->n_cb > 32)
+		g->n_cb = 32;
+	a6_log("cx on, smmu %d smr %d cb, gmu fw reg %x\n", g->n_smr, g->n_cb, rd32(GMU_REG(GMU_FW_VERSION)));
+	return (g->n_smr && g->n_cb) ? 0 : -1;
+}
+
+/* ---- SMMU banks ---- */
+
+/* Stage-1 AArch64 4K page, AF, inner shareable, AttrIndx 0 (NC). priv: AP=00. */
+static void map_gmu_pages(uint64_t l3, uint32_t va, uint64_t pa, uint32_t size, int priv)
+{
+	for (uint32_t o = 0; o < size; o += 0x1000) {
+		uint32_t idx = ((va + o) >> 12) & 0x1ff;
+		wr64(l3 + 8ull * idx, (pa + o) | (1u << 10) | (3u << 8) | (priv ? 0 : (1u << 6)) | 3u);
+	}
+}
+
+static int smmu_pick(const struct a6_gpu *g, int32_t *smr_out, int32_t *cb_out, int cb_min)
+{
+	int smr = -1, cb = -1;
+	uint32_t used = 0;
+	for (int i = 0; i < g->n_smr; i++) {
+		uint32_t m = rd32(SMR(i)), c = rd32(S2CR(i));
+		if ((m >> 31) && ((c >> 16) & 3) == 0)
+			used |= 1u << (c & 0xff);
+		if (smr < 0 && !(m >> 31))
+			smr = i;
+	}
+	for (int i = cb_min; i < g->n_cb; i++)
+		if (!(used & (1u << i)) && !(rd32(SMMU_CB(i) + CB_SCTLR) & 1)) {
+			cb = i;
+			break;
+		}
+	*smr_out = smr;
+	*cb_out = cb;
+	return (smr < 0 || cb < 0) ? -1 : 0;
+}
+
+static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid)
+{
+	uint64_t c = SMMU_CB(cb);
+	wr32(c + CB_SCTLR, 0);
+	wr32(CBA2R(cb), 1);						/* AArch64 descriptors */
+	wr32(CBAR(cb), (1u << 16) | (0xfu << 12) | (3u << 8) | (uint32_t)(cb + 1));	/* S1, S2 bypass */
+	wr32(c + CB_TCR2, TCR2_VAL);
+	wr32(c + CB_TTBR0, (uint32_t)ttbr0);
+	wr32(c + CB_TTBR0 + 4, (uint32_t)(ttbr0 >> 32));
+	wr32(c + CB_TCR, 32 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_MAIR0, 0x0000ff44);
+	wr32(c + CB_FSR, 0xffffffff);
+	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40);			/* M TRE AFE CFRE CFIE */
+	wr32(SMMU + 0x68, 0);						/* TLBIALLNSNH */
+	wr32(SMMU + 0x70, 0);						/* TLBGSYNC */
+	(void)wait_bit(SMMU + 0x74, 1, 0, 10);
+	wr32(S2CR(smr), (uint32_t)cb);
+	wr32(SMR(smr), (1u << 31) | sid);
+}
+
+void a6_tlb_flush(const struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TLBIALL, 0);
+	wr32(c + CB_TLBSYNC, 0);
+	(void)wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
+}
+
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	if (far)
+		*far = ((uint64_t)rd32(c + CB_FAR + 4) << 32) | rd32(c + CB_FAR);
+	if (fsynr0)
+		*fsynr0 = rd32(c + CB_FSYNR0);
+	return rd32(c + CB_FSR);
+}
+
+int a6_clear_fault(const struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	uint32_t fsr = rd32(c + CB_FSR);
+	if (!(fsr & FSR_FAULT))
+		return 0;
+	wr32(c + CB_FSR, fsr);
+	return 1;
+}
+
+/* ---- stage 2: GMU boot (a630 family: legacy) ---- */
+
+static int gmu_smmu(struct a6_gpu *g)
+{
+	if (smmu_pick(g, &g->gmu_smr, &g->gmu_cb, 0)) {
+		a6_log("smmu: no free smr/cb for the GMU\n");
+		return -1;
+	}
+	uint64_t l1 = a6_pool_pa(g, OFF_GMU_L1), l2 = a6_pool_pa(g, OFF_GMU_L2), l3 = a6_pool_pa(g, OFF_GMU_L3);
+	zero_pa(a6_pool_pa(g, 0), 0x30000);
+	wr64(l1 + 8, l2 | 3);
+	wr64(l2 + 8ull * ((VA_DUMMY >> 21) & 0x1ff), l3 | 3);
+	map_gmu_pages(l3, VA_DUMMY, a6_pool_pa(g, OFF_DUMMY), 0x1000, 0);
+	map_gmu_pages(l3, VA_DEBUG, a6_pool_pa(g, OFF_DEBUG), 0x4000, 0);
+	map_gmu_pages(l3, VA_LOG, a6_pool_pa(g, OFF_LOG), 0x4000, 0);
+	map_gmu_pages(l3, VA_HFI, a6_pool_pa(g, OFF_HFI), 0x4000, 0);
+	smmu_bank(g->gmu_smr, g->gmu_cb, l1, GMU_SID);
+	return 0;
+}
+
+/* a6xx_gmu_rpmh_init, a630 family (pdc_address_offset 0x30080) */
+static void rpmh_init(void)
+{
+	static const uint32_t rscc[][2] = {
+		{ 0x0004, 1u << 24 }, { 0x000b, 1 }, { 0x000e, 0 }, { 0x000d, 0 }, { 0x0010, 0 }, { 0x000f, 0 },
+		{ 0x0012, 0x80000000 }, { 0x0011, 0 }, { 0x0100, 0 }, { 0x0008, 0x4520 }, { 0x0009, 0x4510 },
+		{ 0x000a, 0x4514 }, { 0x0180, 0xa7a506a0 }, { 0x0181, 0xa1e6a6e7 }, { 0x0182, 0xa2e081e1 },
+		{ 0x0183, 0xe9a982e2 }, { 0x0184, 0x0020e8a8 },
+	};
+	for (unsigned i = 0; i < sizeof(rscc) / sizeof(rscc[0]); i++)
+		wr32(RSCC_REG(rscc[i][0]), rscc[i][1]);
+	static const uint32_t seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	for (unsigned i = 0; i < 5; i++)
+		wr32(PDC_SEQ + 4 * i, seq[i]);
+	static const uint32_t pdc[][2] = {
+		{ 0x1573, 7 }, { 0x1574, 0 }, { 0x1572, 0 },
+		{ 0x1575, 0x10108 }, { 0x1576, 0x30010 }, { 0x1577, 1 },
+		{ 0x1579, 0x10108 }, { 0x157a, 0x30000 }, { 0x157b, 0 },
+		{ 0x157d, 0x10108 }, { 0x157e, 0x30080 }, { 0x157f, 0 },
+		{ 0x15d7, 7 }, { 0x15d8, 0 }, { 0x15d6, 0 },
+		{ 0x15d9, 0x10108 }, { 0x15da, 0x30010 }, { 0x15db, 2 },
+		{ 0x15dd, 0x10108 }, { 0x15de, 0x30000 }, { 0x15df, 3 },
+		{ 0x15e1, 0x10108 }, { 0x15e2, 0x30080 }, { 0x15e3, 3 },
+		{ 0x1148, 0 }, { 0x1140, 0x80000001 },
+	};
+	for (unsigned i = 0; i < sizeof(pdc) / sizeof(pdc[0]); i++)
+		wr32(PDC_REG(pdc[i][0]), pdc[i][1]);
+}
+
+/* HFI queue table: header (6 dwords) + 3 queue headers (12 dwords); legacy ids 0, 4, 5 */
+static void hfi_table(struct a6_gpu *g)
+{
+	static const uint32_t ids[3] = { 0, 4, 5 };
+	uint32_t t[6 + 36] = { 0, 6 * 4 + 3 * 12 * 4, 6, 12, 3, 3 };
+	for (int q = 0; q < 3; q++) {
+		uint32_t *h = t + 6 + 12 * q;
+		h[0] = 1;
+		h[1] = VA_HFI + 0x1000u * (uint32_t)(q + 1);
+		h[2] = (10u << 8) | ids[q];
+		h[3] = 0x1000 >> 2;
+		h[6] = h[7] = h[8] = h[9] = 1;
+	}
+	a6_write(a6_pool_pa(g, OFF_HFI), t, sizeof(t));
+}
+
+/* RPMh levels and bonito's GPU OPPs every speed bin has (opp-supported-hw 0x0f). */
+static const uint32_t gpu_khz[] = { 0, 180000, 267000, 355000, 430000 };
+static const uint32_t gpu_lvl[] = { 0, 48, 64, 128, 192 };
+#define N_GPU	5
+static const uint32_t gmu_khz[] = { 0, 200000 };
+static const uint32_t gmu_lvl[] = { 0, 48 };
+#define N_GMU	2
+static uint32_t gx_votes[N_GPU], cx_votes[N_GMU];
+
+/* cmd-db aux data (u16 levels) for an id such as "gfx.lvl" */
+static int cmddb_aux(const char *id, uint64_t *aux, uint32_t *len)
+{
+	uint64_t db = CMD_DB;
+	if (rd32(db + 4) != 0x0c0330db)
+		return -1;
+	uint64_t data = db + 4 + 4 + 8 * 16 + 4 + 4;
+	for (int r = 0; r < 8; r++) {
+		uint64_t rh = db + 8 + 16ull * r;
+		uint32_t w0 = rd32(rh), w1 = rd32(rh + 4);
+		uint32_t hoff = w0 >> 16, doff = w1 & 0xffff, cnt = w1 >> 16;
+		for (uint32_t e = 0; e < cnt; e++) {
+			uint64_t ent = data + hoff + 24ull * e;
+			int match = 1;
+			for (int i = 0; i < 8; i++) {
+				char ch = (char)(rd32(ent + (uint64_t)(i & ~3)) >> (8 * (i & 3)));
+				if (ch != id[i]) {
+					match = 0;
+					break;
+				}
+				if (!id[i])
+					break;
+			}
+			if (!match)
+				continue;
+			uint32_t w5 = rd32(ent + 20);
+			*len = w5 & 0xffff;
+			*aux = data + doff + (w5 >> 16);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static uint32_t aux16(uint64_t aux, uint32_t i)
+{
+	return (rd32(aux + 2ull * (i & ~1u)) >> (16 * (i & 1))) & 0xffff;
+}
+
+/* a6xx_gmu_rpmh_arc_votes_init */
+static int arc_votes(uint32_t *votes, const uint32_t *lvl, int n, const char *pri_id, const char *sec_id)
+{
+	uint64_t pri, sec;
+	uint32_t plen, slen;
+	if (cmddb_aux(pri_id, &pri, &plen) || cmddb_aux(sec_id, &sec, &slen))
+		return -1;
+	plen /= 2;
+	slen /= 2;
+	for (int i = 0; i < n; i++) {
+		uint32_t pindex = 0, sindex = 0, j;
+		for (j = 0; j < plen; j++)
+			if (aux16(pri, j) >= lvl[i]) {
+				pindex = j;
+				break;
+			}
+		if (j == plen)
+			return -1;
+		for (j = 0; j < slen; j++) {
+			if (aux16(sec, j) >= lvl[i]) {
+				sindex = j;
+				break;
+			} else if (aux16(sec, j)) {
+				sindex = j;
+			}
+		}
+		votes[i] = (aux16(pri, pindex) << 16) | (sindex << 8) | pindex;
+	}
+	return 0;
+}
+
+/* legacy OOB request: set bit, wait for the ack bit, clear the ack */
+static int oob(const char *name, int set, int ack)
+{
+	wr32(GMU_REG(GMU_H2G_SET), 1u << set);
+	int rc = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << ack, 1, 100);
+	wr32(GMU_REG(GMU_G2H_CLR), 1u << ack);
+	if (rc)
+		a6_log("oob %s: timeout (info %x)\n", name, rd32(GMU_REG(GMU_G2H_INFO)));
+	return rc;
+}
+
+static int gmu_boot(struct a6_gpu *g)
+{
+	if (gmu_smmu(g))
+		return -1;
+	if (arc_votes(gx_votes, gpu_lvl, N_GPU, "gfx.lvl", "mx.lvl") ||
+	    arc_votes(cx_votes, gmu_lvl, N_GMU, "cx.lvl", "mx.lvl")) {
+		a6_log("cmd-db levels not found\n");
+		return -1;
+	}
+	rpmh_init();
+	hfi_table(g);
+
+	/* a6xx_gmu_fw_start; no a6xx_rpmh_start on a cold boot (Linux skips it too) */
+	wr32(GMU_REG(GMU_GENERAL_7), 1);
+	uint32_t flen;
+	const uint8_t *fw = a6_firmware("a630_gmu.bin", &flen);
+	if (!fw || flen > 0x8000 || (flen & 3)) {
+		a6_log("gmu firmware missing or too big\n");
+		return -1;
+	}
+	a6_write(GMU_REG(GMU_ITCM), fw, flen);			/* legacy: raw ITCM image */
+
+	wr32(GMU_REG(GMU_INIT_RESULT), 0);
+	wr32(GMU_REG(GMU_BOOT_CFG), 2);
+	wr32(GMU_REG(GMU_QTBL_ADDR), VA_HFI);
+	wr32(GMU_REG(GMU_QTBL_INFO), 1);
+	wr32(GMU_REG(GMU_FENCE0), (1u << 31) | (0xau << 18) | 0xa0);
+	wr32(GMU_REG(GMU_CM3_CFG), 0x4052);
+	wr32(GMU_REG(GMU_SFR_ADDR), 0x06015000);		/* GMU chip id layout of 615.0.0 */
+	wr32(GMU_REG(GMU_CP_MSG), VA_LOG | (0x4000 / 0x1000 - 1));
+	wr32(GMU_REG(GMU_SYS_BUS), 1);
+	wr32(GMU_REG(GMU_ICACHE_CFG), 1);
+	wr32(GMU_REG(GMU_DCACHE_CFG), 1);
+	wr32(GMU_REG(GMU_PWRCOL_CTRL), 0x9c40400);
+	wr32(GMU_REG(GMU_RPMH_CTRL), rd32(GMU_REG(GMU_RPMH_CTRL)) |
+	     1 | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+
+	uint32_t v = rd32(GMU_REG(GMU_DTCM) + 0xff8 * 4);
+	uint32_t mask = v <= 0x20010004 ? 0xffffffff : 0x1ff;
+	uint32_t want = v <= 0x20010004 ? 0xbabeface : 0x100;
+	wr32(GMU_REG(GMU_SYSRESET), 1);
+	wr32(GMU_REG(GMU_CP_RESP), 0);
+	wr32(GMU_REG(GMU_SYSRESET), 0);
+	uint32_t r = 0;
+	int ok = 0;
+	for (int i = 0; i < 1000 && !ok; i++) {
+		r = rd32(GMU_REG(GMU_INIT_RESULT));
+		if ((r & mask) == want)
+			ok = 1;
+		else
+			a6_delay_us(100);
+	}
+	if (!ok) {
+		a6_log("gmu: init result %x timeout\n", r);
+		return -1;
+	}
+
+	/* legacy: a6xx_gmu_gfx_rail_on + a6xx_sptprac_enable */
+	wr32(GMU_REG(GMU_BOOT_SLUMBER), 0);
+	wr32(GMU_REG(GMU_GX_VOTE_IDX), gx_votes[N_GPU - 1] & 0xff);
+	wr32(GMU_REG(GMU_MX_VOTE_IDX), (gx_votes[N_GPU - 1] >> 8) & 0xff);
+	if (oob("boot_slumber", 22, 30))
+		return -1;
+	wr32(GMU_REG(GMU_GX_SPTPRAC_PWR), 0x778000);
+	int sp = -1;
+	for (int i = 0; i < 100 && sp; i++) {
+		if ((rd32(GMU_REG(GMU_SPTPRAC_STATUS)) & 0x38) == 0x28)
+			sp = 0;
+		else
+			a6_delay_us(10);
+	}
+	if (sp)
+		a6_log("sptprac not on (%x)\n", rd32(GMU_REG(GMU_SPTPRAC_STATUS)));
+
+	wr32(GMU_REG(GMU_HFI_CTRL_INIT), 1);
+	if (wait_bit(GMU_REG(GMU_HFI_CTRL_STATUS), 1, 1, 10)) {
+		a6_log("hfi ctrl: timeout\n");
+		return -1;
+	}
+	a6_log("gmu booted (fw %x)\n", rd32(GMU_REG(GMU_FW_VERSION)));
+	return 0;
+}
+
+/* ---- stage 3: HFI v1 ---- */
+
+#define QHDR(g, q)	(a6_pool_pa(g, OFF_HFI) + 24 + 48ull * (q))
+#define QDATA(g, q)	(a6_pool_pa(g, OFF_HFI) + 0x1000ull * ((q) + 1))
+#define QSIZE		1024
+
+static int hfi_send(struct a6_gpu *g, uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	uint32_t seq = ++g->hfi_seq & 0xfff;
+	msg[0] = (seq << 20) | (0u << 16) | (dwords << 8) | id;
+	uint64_t h = QHDR(g, 0);
+	uint32_t w = rd32(h + 44);
+	for (uint32_t i = 0; i < dwords; i++) {
+		wr32(QDATA(g, 0) + 4ull * w, msg[i]);
+		w = (w + 1) % QSIZE;
+	}
+	wr32(h + 44, w);
+	wr32(GMU_REG(GMU_H2G_SET), 1);
+
+	for (int t = 0; t < 2000; t++) {
+		if (rd32(GMU_REG(GMU_G2H_INFO)) & 1) {
+			wr32(GMU_REG(GMU_G2H_CLR), 1);
+			uint64_t rh = QHDR(g, 1);
+			while (rd32(rh + 40) != rd32(rh + 44)) {
+				uint32_t r = rd32(rh + 40), hdr = rd32(QDATA(g, 1) + 4ull * r);
+				uint32_t n = (hdr >> 8) & 0xff, buf[24] = { 0 };
+				for (uint32_t i = 0; i < n; i++) {
+					if (i < 24)
+						buf[i] = rd32(QDATA(g, 1) + 4ull * r);
+					r = (r + 1) % QSIZE;
+				}
+				wr32(rh + 40, r);
+				if ((hdr & 0xff) == 100) {
+					a6_log("hfi: gmu error %x %x\n", buf[1], buf[2]);
+					continue;
+				}
+				if ((buf[1] >> 20) == seq)
+					return (int)buf[2];
+			}
+		}
+		delay_ms(1);
+	}
+	a6_log("hfi: msg %u: no ack\n", id);
+	return -1;
+}
+
+static int gmu_hfi(struct a6_gpu *g)
+{
+	static uint32_t msg[192];
+	int rc;
+
+	memset(msg, 0, sizeof(msg));
+	msg[2] = VA_DEBUG;
+	msg[3] = 0x4000;
+	msg[4] = 1;				/* boot_state: cold */
+	if ((rc = hfi_send(g, 0, msg, 5)))
+		return a6_log("hfi init -> %d\n", rc), -1;
+	msg[1] = (1u << 28) | (1u << 19) | (1u << 17);
+	(void)hfi_send(g, 1, msg, 2);		/* fw version */
+
+	memset(msg, 0, sizeof(msg));		/* perf table v1 */
+	msg[1] = N_GPU;
+	msg[2] = N_GMU;
+	for (int i = 0; i < N_GPU; i++) {
+		msg[3 + 2 * i] = gx_votes[i];
+		msg[4 + 2 * i] = gpu_khz[i];
+	}
+	for (int i = 0; i < N_GMU; i++) {
+		msg[3 + 32 + 2 * i] = cx_votes[i];
+		msg[4 + 32 + 2 * i] = gmu_khz[i];
+	}
+	if ((rc = hfi_send(g, 4, msg, 3 + 32 + 8)))
+		return a6_log("hfi perf table -> %d\n", rc), -1;
+
+	memset(msg, 0, sizeof(msg));		/* bw table: a6xx_build_bw_table (sdm845 family) */
+	msg[1] = 1;
+	msg[2] = 3;
+	msg[3] = 3;
+	msg[4] = 0x05;
+	msg[5] = 0x07;
+	msg[6] = 0x50034;
+	msg[7] = 0x5007c;
+	msg[8] = 0x5004c;
+	msg[12] = 0x40000000;
+	msg[14] = 0x40000000;
+	msg[18] = 0x60000001;
+	msg[19] = 0x20000001;
+	msg[20] = 0x60000001;
+	msg[24] = 0x50000;
+	msg[25] = 0x5005c;
+	msg[26] = 0x5000c;
+	msg[32] = 0x40000000;
+	msg[33] = 0x40000000;
+	msg[34] = 0x40000000;
+	if ((rc = hfi_send(g, 3, msg, 32 + 128)))
+		return a6_log("hfi bw table -> %d\n", rc), -1;
+	(void)hfi_send(g, 5, msg, 1);		/* TEST: no more messages until next boot */
+	return 0;
+}
+
+/* ---- stage 4: zap shader through TrustZone PAS ---- */
+
+static int64_t scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t x[8] = { SCM_PIL(cmd), arginfo, a, b, c, 0, 0, 0 };
+	a6_smc(x);
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+static int zap_load(struct a6_gpu *g)
+{
+	uint32_t mlen, slen;
+	const uint8_t *mdt = a6_firmware("a615_zap.mdt", &mlen), *b02 = a6_firmware("a615_zap.b02", &slen);
+	if (!mdt || !b02 || mlen > 0x10000 || slen > ZAP_SIZE) {
+		a6_log("zap firmware missing\n");
+		return -1;
+	}
+	uint64_t r1 = 0;
+	a6_write(a6_pool_pa(g, A6_OFF_ZAP_META), mdt, (mlen + 3) & ~3u);
+	int64_t rc = scm(1, 2 | (2u << 6), PAS_GPU, a6_pool_pa(g, A6_OFF_ZAP_META), 0, &r1);	/* INIT_IMAGE */
+	if (rc || r1)
+		return a6_log("zap: init image rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1), -1;
+	rc = scm(2, 3, PAS_GPU, ZAP_REGION, ZAP_SIZE, &r1);					/* MEM_SETUP */
+	if (rc || r1)
+		return a6_log("zap: mem setup rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1), -1;
+	zero_pa(ZAP_REGION, ZAP_SIZE);		/* relocatable: the one LOAD segment at the region base */
+	a6_write(ZAP_REGION, b02, (slen + 3) & ~3u);
+	rc = scm(5, 1, PAS_GPU, 0, 0, &r1);							/* AUTH_AND_RESET */
+	if (rc || r1)
+		return a6_log("zap: auth and reset rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1), -1;
+	return 0;
+}
+
+/* ---- ring ---- */
+
+static uint32_t pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+				  (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms)
+{
+	if (n >= A6_RING_DW)
+		return -1;
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	unsigned i;
+	for (i = 0; i < timeout_ms * 20; i++) {
+		if (rd32(GREG(CP_RB_RPTR)) == g->wptr && !(rd32(GREG(RBBM_STATUS)) & (1u << 23)))
+			break;
+		a6_delay_us(50);
+	}
+	bool ok = i < timeout_ms * 20;
+	if (what || !ok)
+		a6_log("ring %s: rptr %x wptr %x status %x int %x hwfault %x cp_status1 %x %s\n",
+		       what ? what : "", rd32(GREG(CP_RB_RPTR)), g->wptr, rd32(GREG(RBBM_STATUS)),
+		       rd32(GREG(RBBM_INT_STATUS)), rd32(GREG(CP_HW_FAULT)), rd32(GREG(CP_STATUS_1)),
+		       ok ? "idle" : "TIMEOUT");
+	return ok ? 0 : -1;
+}
+
+uint32_t a6_fence_read(const struct a6_gpu *g)
+{
+	uint32_t v = 0;
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+	return v;
+}
+
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t fence = ++g->fence;
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+	};
+	int rc = a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms);
+	return rc || a6_fence_read(g) != fence ? -1 : 0;
+}
+
+/* ---- GPU page tables ---- */
+
+static void map_gpu_low(struct a6_gpu *g)
+{
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1), l2 = a6_pool_pa(g, A6_OFF_GT_L2);
+	zero_pa(l1, 0x2000);
+	wr64(l1 + 0, l2 | 3);		/* VA 0-1 GB */
+	for (uint64_t o = 0; o < A6_POOL_SIZE; o += 0x200000)	/* AP=01, NC, 2 MB blocks */
+		wr64(l2 + 8 * (((A6_GVA_POOL + o) >> 21) & 0x1ff),
+		     (g->pool_pa + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	for (uint64_t o = 0; o < A6_FB_SIZE; o += 0x200000)
+		wr64(l2 + 8 * (((A6_GVA_FB + o) >> 21) & 0x1ff),
+		     (A6_FB_PA + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+}
+
+static uint64_t pt_alloc(struct a6_gpu *g)
+{
+	uint64_t off = A6_OFF_PT_ARENA + 0x1000ull * g->pt_next;
+	if (off + 0x1000 > A6_OFF_SQE)
+		return 0;
+	g->pt_next++;
+	zero_pa(a6_pool_pa(g, off), 0x1000);
+	return a6_pool_pa(g, off);
+}
+
+static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
+{
+	uint64_t e = 0;
+	a6_read(table + 8ull * idx, &e, 8);
+	if (e & 1)
+		return (e & 3) == 3 ? e & 0xfffffff000ull : 0;	/* 0: a block */
+	uint64_t t = pt_alloc(g);
+	if (t)
+		wr64(table + 8ull * idx, t | 3);
+	return t;
+}
+
+static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
+		  const void *arg)
+{
+	static uint64_t pte[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	for (uint32_t i = 0; i < n4k;) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t l2 = pt_walk(g, l1, (va >> 30) & 0x1ff);
+		uint64_t l3 = l2 ? pt_walk(g, l2, (va >> 21) & 0x1ff) : 0;
+		if (!l3) {
+			a6_log("map: no page table for %llx\n", (unsigned long long)va);
+			return -1;
+		}
+		unsigned first = (va >> 12) & 0x1ff, k = 0;
+		while (first + k < 512 && i < n4k)
+			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		a6_write(l3 + 8ull * first, pte, 8ull * k);
+	}
+	return 0;
+}
+
+static uint64_t linear_pa(const void *arg, uint32_t i)
+{
+	return *(const uint64_t *)arg + 0x1000ull * i;
+}
+
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size)
+{
+	return map_4k(g, iova, (uint32_t)((size + 0xfff) >> 12), linear_pa, &pa);
+}
+
+struct page_list {
+	const uint64_t *pages;
+	uint32_t shift;		/* log2(page_size / 4K) */
+};
+
+static uint64_t list_pa(const void *arg, uint32_t i)
+{
+	const struct page_list *l = arg;
+	return l->pages[i >> l->shift] + 0x1000ull * (i & ((1u << l->shift) - 1));
+}
+
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	struct page_list l = { pages, 0 };
+	while ((0x1000u << l.shift) < page_size)
+		l.shift++;
+	return map_4k(g, iova, npages << l.shift, list_pa, &l);
+}
+
+void a6_unmap_high(struct a6_gpu *g)
+{
+	static const uint64_t zeros[511];
+	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
+	g->pt_next = 0;
+	uint64_t c = SMMU_CB(g->gpu_cb);	/* 39-bit VA from now on (T0SZ 25) */
+	wr32(c + CB_TCR, 25 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	a6_tlb_flush(g);
+}
+
+/* ---- stage 5: GX via the GMU, hw_init, SQE, CP, zap ---- */
+
+static int gpu_cp(struct a6_gpu *g)
+{
+	if (smmu_pick(g, &g->gpu_smr, &g->gpu_cb, g->gmu_cb + 1)) {
+		a6_log("smmu: no free smr/cb for the GPU\n");
+		return -1;
+	}
+	map_gpu_low(g);
+	smmu_bank(g->gpu_smr, g->gpu_cb, a6_pool_pa(g, A6_OFF_GT_L1), GPU_SID);
+
+	if (oob("gpu_set", 16, 24))	/* legacy GPU_SET: the GMU powers the GX side */
+		return -1;
+	if (!(rd32(GPUCC + GPUCC_GX_GDSCR) & (1u << 31))) {
+		a6_log("GX not powered (gdsc %x)\n", rd32(GPUCC + GPUCC_GX_GDSCR));
+		return -1;
+	}
+
+	/* hw_init subset (a6xx_gpu.c) for the A615: GBIF, GMEM 512K */
+	wr32(GREG(0x3c45), 0);			/* GBIF_HALT */
+	(void)rd32(GREG(0x3c45));
+	wr32(GREG(0x16), 0);			/* RBBM_GBIF_HALT */
+	(void)rd32(GREG(0x16));
+	static const uint32_t init[][2] = {
+		{ 0xf803, 0 }, { 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },
+		{ 0x0842, 1 }, { 0x0c01, 1 }, { 0x8601, 1 }, { 0x8e05, 1 }, { 0x9e01, 1 }, { 0xbe05, 1 },
+		{ 0xa601, 1 }, { 0x9601, 1 }, { 0x0e00, 1 }, { 0xae01, 1 }, { 0xb601, 1 }, { 0xf810, 1 },
+		{ 0x0011, 3 }, { 0x050b, 0xffffffff },
+		{ 0x0e05, 0xffffffc0 }, { 0x0e06, 0x1ffff }, { 0x0e09, 0xfffff000 }, { 0x0e0a, 0x1ffff },
+		{ 0x0e07, 0xfffff000 }, { 0x0e08, 0x1ffff },
+		{ 0x0e0b, 0x100000 }, { 0x0e0c, 0 }, { 0x0e0d, 0x100000 + 0x80000 - 1 }, { 0x0e0e, 0 },
+		{ 0x0e18, 0x804 }, { 0x0e17, 0x4 },
+		{ 0x08c2, 0x010000c0 }, { 0x08c1, 0x8040362c }, { 0x08c3, 128 },
+		{ 0x098d, 1 }, { 0x0500, 1 },
+		{ 0x001f, (1u << 30) | 0x1fffff },
+		{ 0x0e19, (1u << 7) | 1 },
+		{ 0x9e00, 0x00180000 },		/* PC_DBG_ECO_CNTL: prim_fifo_threshold (a615) */
+	};
+	for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++)
+		wr32(GREG(init[i][0]), init[i][1]);
+
+	uint32_t len;
+	const uint8_t *sqe = a6_firmware("a630_sqe.fw", &len);
+	if (!sqe || len < 8 || len > 0x10000)
+		return a6_log("sqe firmware missing\n"), -1;
+	a6_write(a6_pool_pa(g, A6_OFF_SQE), sqe + 4, (len - 4 + 3) & ~3u);	/* minus the first dword */
+	wr32(GREG(CP_SQE_INSTR_BASE), (uint32_t)a6_pool_va(A6_OFF_SQE));
+	wr32(GREG(CP_SQE_INSTR_BASE + 1), 0);
+	wr32(GREG(CP_RB_BASE), (uint32_t)a6_pool_va(A6_OFF_RING));
+	wr32(GREG(CP_RB_BASE + 1), 0);
+	wr32(GREG(CP_RB_CNTL), 0x0800020c);	/* 32K ring, 32-byte blocks, no rptr update */
+	g->wptr = 0;
+	wr32(GREG(CP_SQE_CNTL), 1);
+
+	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
+	if (a6_ring(g, me_init, 9, "me_init", 1000))
+		return -1;
+	if (zap_load(g))
+		return -1;
+	uint32_t secure[] = { a6_pkt7(A6_CP_SET_SECURE_MODE, 1), 0 };
+	return a6_ring(g, secure, 2, "secure mode off", 1000);
+}
+
+int a6_power_up(struct a6_gpu *g)
+{
+	if (power_cx(g) || gmu_boot(g) || gmu_hfi(g) || gpu_cp(g))
+		return -1;
+	return 0;
+}
+
+/* ---- 2D blit (turnip's r2d path; A615 = a6xx gen1 magic registers from Mesa) ---- */
+
+static const uint32_t blit_state[][2] = {
+	{ 0x9804, 0x1f }, { 0x9805, 0 }, { 0xa0f8, 0 }, { 0xb600, 0x00108000 }, { 0x8600, 0x880 },
+	{ 0xae03, 0x430 }, { 0xae00, 0 }, { 0xbe04, 0x80000 }, { 0x9600, 0 }, { 0x0e12, 1 },
+	{ 0x8e01, 1 }, { 0x8e04, 0x04100000 },
+	{ 0xae04, 0 }, { 0xae0f, 0x3f }, { 0xb605, 0x44 },
+	{ 0xbe00, 0x80 }, { 0xbe01, 0 }, { 0xab20, 0 }, { 0xb182, 0 }, { 0xbb11, 0 }, { 0xa9a8, 0 },
+	{ 0xab00, 5 }, { 0xa009, 3 }, { 0x8811, 0x10 }, { 0x8110, 0 }, { 0x8818, 0 }, { 0x8819, 0 },
+	{ 0x881a, 0 }, { 0x881b, 0 }, { 0x881c, 0 }, { 0x881d, 0 }, { 0x881e, 0 }, { 0x88f0, 0 },
+	{ 0x9236, 0 }, { 0x9300, 0 }, { 0x9306, 1 }, { 0xb183, 0 }, { 0x80af, 0 }, { 0x8099, 0 },
+	{ 0x980a, 0 }, { 0x9210, 0 }, { 0x9211, 0 }, { 0x9602, 0 }, { 0x9e72, 0 }, { 0xb309, 0xa2 },
+	{ 0xb986, 0xfc }, { 0xa007, 0 }, { 0x8864, 0 }, { 0xb800, 0x102 },
+	{ 0x8e07, 0x08000000 },		/* RB_CCU_CNTL: sysmem, 1 CCU */
+	{ 0x80f0, 0 }, { 0x80f1, 0x3fff | (0x3fffu << 16) },	/* window scissor: full */
+};
+
+#define EV_CACHE_FLUSH_TS		0x04
+#define EV_PC_CCU_INVALIDATE_COLOR	0x19
+#define EV_PC_CCU_FLUSH_DEPTH_TS	0x1c
+#define EV_PC_CCU_FLUSH_COLOR_TS	0x1d
+#define EV_CACHE_INVALIDATE		0x31
+
+#define EV(e)		do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)	do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; \
+			     dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)	do { dw[n++] = a6_pkt4((r), 1); dw[n++] = (v); } while (0)
+
+uint32_t a6_blit_init_ib(uint32_t *dw)
+{
+	uint32_t n = 0;
+	uint64_t border = a6_pool_va(A6_OFF_SCRATCH + 0x800), ts = a6_pool_va(A6_OFF_SCRATCH + 0x900);
+	EV(EV_CACHE_INVALIDATE);
+	REG(0xbb08, 0xfffff);		/* SP_UPDATE_CNTL */
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (unsigned i = 0; i < sizeof(blit_state) / sizeof(blit_state[0]); i++)
+		REG(blit_state[i][0], blit_state[i][1]);
+	dw[n++] = a6_pkt4(0xb302, 2);	/* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = a6_pkt4(0xb180, 2);	/* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV(EV_PC_CCU_INVALIDATE_COLOR);
+	EV(EV_CACHE_INVALIDATE);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	return n;
+}
+
+uint32_t a6_blit_ib(const struct a6_blit *b, uint32_t *dw, uint32_t n)
+{
+	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + 0x900);
+	REG(0x840a, 0);			/* GRAS_A2D_SCISSOR_TL/BR: no clip */
+	REG(0x840b, 0x3fff | (0x3fffu << 16));
+	REG(0x8c01, 0);			/* RB_A2D_PIXEL_CNTL */
+	REG(0x8c00, 0x00f03000);	/* RB_A2D_BLT_CNTL: 8888 UNORM, mask f */
+	REG(0x8400, 0x00f03000);	/* GRAS_A2D_BLT_CNTL */
+	REG(0xacc0, 0xf180);		/* SP_A2D_OUTPUT_INFO */
+	dw[n++] = a6_pkt4(0x8405, 2);	/* GRAS_A2D_DEST_TL, _BR (inclusive) */
+	dw[n++] = b->dx | (b->dy << 16);
+	dw[n++] = (b->dx + b->dw - 1) | ((b->dy + b->dh - 1) << 16);
+	dw[n++] = a6_pkt4(0x8401, 4);	/* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+	dw[n++] = b->sx << 8;
+	dw[n++] = (b->sx + b->sw - 1) << 8;
+	dw[n++] = b->sy << 8;
+	dw[n++] = (b->sy + b->sh - 1) << 8;
+	dw[n++] = a6_pkt4(0xb4c0, 5);	/* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+	dw[n++] = 0x00500030 | ((b->src_swap ? (b->src_swap - 1u) & 3 : 1u) << 10) | (b->filter ? 0x10000 : 0);
+	dw[n++] = b->src_w | (b->src_h << 15);
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = b->src_pitch << 3;
+	dw[n++] = a6_pkt4(0xb4ca, 3);	/* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt4(0x8c17, 4);	/* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = b->dst_pitch >> 6;
+	dw[n++] = a6_pkt4(0x8c20, 3);	/* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);	/* blit_wfi_quirk */
+	dw[n++] = a6_pkt7(A6_CP_BLIT, 1);
+	dw[n++] = 3;			/* BLIT_OP_SCALE */
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV_TS(EV_PC_CCU_FLUSH_DEPTH_TS);
+	EV_TS(EV_CACHE_FLUSH_TS);
+	return n;
+}
+#undef EV
+#undef EV_TS
+#undef REG
+#endif
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
new file mode 100644
index 0000000..70f4d5b
--- /dev/null
+++ b/bsd/dev/sweet_a6xx.h
@@ -0,0 +1,130 @@
+/*
+ * Adreno 615 core (bonito, SDM670): power and legacy GMU boot, HFI v1, SMMU
+ * banks, SQE + CP + zap shader, ringbuffer submission, 4K page mappings and
+ * the 2D blit stream. Ported from the bonito shim bring-up (shim/gpu.c,
+ * proven on the phone 2026-11-07) in the shape of ios-flame's sweet_a6xx
+ * (Pixel 4 / A640, MIT, dipa-studio).
+ *
+ * The environment (bsd/dev/sweet_gpu.c) supplies the a6_* hooks below.
+ *
+ * One 16 MB contiguous pool (2 MB aligned) holds the GPU's own memory:
+ *
+ *   pool + 0x000000  GMU page tables, dummy/debug/log/HFI pages
+ *   pool + 0x0a0000  zap shader metadata for TrustZone
+ *   pool + 0x100000  GPU page tables: L1, L2 (2 MB blocks), then an arena of 4K tables
+ *   pool + 0x200000  SQE microcode
+ *   pool + 0x210000  ringbuffer (32 KB)
+ *   pool + 0x218000  scratch: fence (+0), border colours (+0x800), event timestamps (+0x900)
+ *   pool + 0x400000  free for the environment (present IB, scaled frame)
+ *
+ * GPU VA (39 bits after bring-up): the pool at 0x10000000, the panel
+ * framebuffer at 0x20000000, surfaces with 4K pages from 4 GB up.
+ */
+#ifndef SWEET_A6XX_H
+#define SWEET_A6XX_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stdarg.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#endif
+
+#define A6_POOL_SIZE		0x1000000ull
+#define A6_POOL_ALIGN		0x200000ull
+#define A6_OFF_ZAP_META		0x0a0000ull
+#define A6_OFF_GT_L1		0x100000ull
+#define A6_OFF_GT_L2		0x101000ull
+#define A6_OFF_PT_ARENA		0x102000ull
+#define A6_OFF_SQE		0x200000ull
+#define A6_OFF_RING		0x210000ull
+#define A6_OFF_SCRATCH		0x218000ull
+#define A6_OFF_FREE		0x400000ull
+
+#define A6_GVA_POOL		0x10000000ull
+#define A6_GVA_FB		0x20000000ull
+#define A6_RING_SIZE		0x8000u
+#define A6_RING_DW		(A6_RING_SIZE / 4)
+
+#define A6_FB_PA		0x9c000000ull	/* bonito cont_splash_region */
+#define A6_FB_SIZE		0xa00000ull	/* mapped for the GPU: 5 x 2 MB */
+
+#define A6_GPU_ID		615
+#define A6_CHIP_ID		0x06010500ull
+
+struct a6_gpu {
+	uint64_t pool_pa;
+	int32_t gmu_smr, gmu_cb, gpu_smr, gpu_cb;
+	int32_t n_smr, n_cb;
+	uint32_t wptr;			/* ring write pointer, dwords */
+	uint32_t fence;			/* last fence value submitted */
+	uint32_t hfi_seq;
+	uint32_t pt_next;		/* next free table in the arena */
+};
+
+/* ---- environment ---- */
+uint32_t a6_rd(uint64_t pa);
+void a6_wr(uint64_t pa, uint32_t v);
+int a6_write(uint64_t pa, const void *buf, size_t len);	/* DRAM: any size; MMIO: words */
+int a6_read(uint64_t pa, void *buf, size_t len);
+void a6_delay_us(unsigned us);
+void a6_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void a6_smc(uint64_t x[8]);				/* x0..x7 in, x0..x3 out */
+const uint8_t *a6_firmware(const char *name, uint32_t *len);	/* NULL if missing */
+
+/* ---- core ---- */
+static inline uint64_t a6_pool_pa(const struct a6_gpu *g, uint64_t off) { return g->pool_pa + off; }
+static inline uint64_t a6_pool_va(uint64_t off) { return A6_GVA_POOL + off; }
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa);
+int a6_power_up(struct a6_gpu *g);	/* everything up to a working CP with the zap shader; 0 = ok */
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt);
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt);
+
+/* Queue dwords into the ring, move WPTR, wait for rptr == wptr and !busy. what: log label or NULL. */
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms);
+/* IB at iova, then WFI + fence write; waits for the fence. 0 = ok. */
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms);
+uint32_t a6_fence_read(const struct a6_gpu *g);
+
+/* 4K pages (AP=01, NC) at iova -> pa; tables from the arena. Then a6_tlb_flush. */
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size);
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+void a6_unmap_high(struct a6_gpu *g);	/* drop all mappings above 1 GB, reset the arena, 39-bit VA */
+void a6_tlb_flush(const struct a6_gpu *g);
+int a6_clear_fault(const struct a6_gpu *g);	/* 1 if an SMMU fault was cleared */
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0);
+
+/*
+ * 2D-engine blits (turnip's r2d path, A615 state): BGRA8 linear -> BGRA8
+ * linear, pitches and bases 64-byte aligned. a6_blit_init_ib emits the
+ * one-time state; a6_blit_ib appends one blit and returns the new length.
+ */
+struct a6_blit {
+	uint64_t src_iova;
+	uint32_t src_w, src_h, src_pitch;
+	uint32_t sx, sy, sw, sh;		/* source rectangle */
+	uint64_t dst_iova;
+	uint32_t dst_pitch;
+	uint32_t dx, dy, dw, dh;		/* destination rectangle */
+	bool filter;				/* bilinear */
+	uint8_t src_swap;			/* 0: normal (WXYZ); else component swap + 1 */
+};
+#define A6_BLIT_MAX_DW	96			/* per blit */
+#define A6_BLIT_INIT_MAX_DW	160
+uint32_t a6_blit_init_ib(uint32_t *dw);
+uint32_t a6_blit_ib(const struct a6_blit *b, uint32_t *dw, uint32_t n);
+
+#define A6_CP_NOP		0x10
+#define A6_CP_WAIT_FOR_IDLE	0x26
+#define A6_CP_BLIT		0x2c
+#define A6_CP_MEM_WRITE		0x3d
+#define A6_CP_INDIRECT_BUFFER	0x3f
+#define A6_CP_EVENT_WRITE	0x46
+#define A6_CP_ME_INIT		0x48
+#define A6_CP_SET_SECURE_MODE	0x66
+#define A6_CP_MEMCPY		0x75
+
+#endif
