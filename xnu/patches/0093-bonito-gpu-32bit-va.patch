diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index 90d4ff4..c044ac0 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -818,9 +818,8 @@ void a6_unmap_high(struct a6_gpu *g)
 	static const uint64_t zeros[511];
 	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
 	g->pt_next = 0;
-	uint64_t c = SMMU_CB(g->gpu_cb);	/* 39-bit VA from now on (T0SZ 25) */
-	wr32(c + CB_TCR, 25 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
-	wr32(c + CB_TCR2, TCR2_VAL);
+	/* The A615 has 32-bit GPU addresses (Linux: ADRENO_QUIRK_4GB_VA): the bank keeps T0SZ 32
+	 * (flame's A640 widened it to 39 bits for surfaces at 4 GB; that faulted here). */
 	a6_tlb_flush(g);
 }
 
