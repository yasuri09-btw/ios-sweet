--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -475,11 +475,31 @@ bonito_spmi_cmd(vm_offset_t ch, uint32_t cmd, uint8_t *rd)
 }
 
 static bool
-bonito_pmic_read(uint16_t apid, uint8_t reg, uint8_t *out)
+bonito_pmic_read_once(uint16_t apid, uint8_t reg, uint8_t *out)
 {
 	return bonito_spmi_cmd(bt.obs + 0x80u * apid, (1u << 27) | ((uint32_t)reg << 4), out);
 }
 
+/*
+ * One observer read of PM660 GPIO12's subtype returned 0 (boot 0088b) where
+ * the boot before read 0x10, and the wrong register layout left ts_1p8 off.
+ * Accept a value only when two reads in a row agree (up to 8 attempts).
+ */
+static bool
+bonito_pmic_read(uint16_t apid, uint8_t reg, uint8_t *out)
+{
+	uint8_t a = 0, b = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		if (bonito_pmic_read_once(apid, reg, &a) && bonito_pmic_read_once(apid, reg, &b) && a == b) {
+			*out = a;
+			return true;
+		}
+		delay(100);
+	}
+	printf("SWEET TOUCH: PMIC apid %u reg %#x unstable (%#x/%#x)\n", apid, reg, a, b);
+	return false;
+}
+
 static bool
 bonito_pmic_write(vm_offset_t ch, uint8_t reg, uint8_t val)
 {
@@ -539,8 +559,10 @@ bonito_touch_power(void)
 	bool lvmv = subtype >= 0x10u && subtype <= 0x13u;
 	printf("SWEET TOUCH: ts_1p8 GPIO12 apid=%u apps=%d type=%#x subtype=%#x mode=%#x out=%#x en=%#x\n",
 	    apid, apps, type, subtype, mode, out, en);
-	if (type != 0x10u) {
-		printf("SWEET TOUCH: peripheral 0xcb is not a GPIO; not touching the PMIC\n");
+	/* PM660 GPIOs read subtype 0x10 (GPIO_LV) on bonito; refuse anything unexpected. */
+	if (type != 0x10u || !lvmv) {
+		printf("SWEET TOUCH: peripheral 0xcb type %#x subtype %#x unexpected; not touching the PMIC\n",
+		    type, subtype);
 		return false;
 	}
 	if (!apps) {
@@ -551,15 +573,13 @@ bonito_touch_power(void)
 	if (!ch) {
 		return false;
 	}
-	bool ok = lvmv ?
-	    bonito_pmic_write(ch, 0x40, 0x01) && bonito_pmic_write(ch, 0x44, 0x80) :
-	    bonito_pmic_write(ch, 0x40, 0x11);
-	ok = ok && bonito_pmic_write(ch, 0x46, 0x80);
+	bool ok = bonito_pmic_write(ch, 0x40, 0x01) && bonito_pmic_write(ch, 0x44, 0x80) &&
+	    bonito_pmic_write(ch, 0x46, 0x80);
 	(void)bonito_pmic_read(apid, 0x40, &mode);
 	(void)bonito_pmic_read(apid, 0x44, &out);
 	(void)bonito_pmic_read(apid, 0x46, &en);
 	printf("SWEET TOUCH: ts_1p8 on=%d: mode=%#x out=%#x en=%#x\n", ok, mode, out, en);
-	return ok;
+	return ok && mode == 0x01u && out == 0x80u && (en & 0x80u);
 }
 
